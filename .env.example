# MongoDB connection string, including the database name.
#   Local:  mongodb://localhost:27017/foodpanda_ai
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/foodpanda_ai
MONGODB_URI=

# LLM provider: gemini (default, free) | groq (free backup) | anthropic (paid)
LLM_PROVIDER=gemini
# Optional. Leave empty for the provider defaults (small, fast models; gemini shown):
#   LLM_MODEL         ranks results          (gemini-3.5-flash-lite)
#   LLM_FAST_MODEL    parses queries         (gemini-3.5-flash-lite)
#   LLM_BACKUP_MODEL  one retry on 429/503   (gemini-3.1-flash-lite, separate quota)
LLM_MODEL=
LLM_FAST_MODEL=
LLM_BACKUP_MODEL=

# Only the key for the selected LLM_PROVIDER is required.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
